<Window
    x:Class="MiAir.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tb="using:H.NotifyIcon"
    xmlns:vm="using:MiAir.WinUI.ViewModels"
    mc:Ignorable="d"
    Title="MiAir for Windows">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt"/>
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom Fluent AppTitleBar -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="44" Padding="16,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE8D7;" FontSize="15" Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                <TextBlock Text="MiAir 小爱投播" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Main Navigation View -->
        <NavigationView x:Name="NavView"
                        Grid.Row="1"
                        PaneDisplayMode="Left"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        SelectionChanged="OnNavViewSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="运行看板" Tag="dashboard">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9F5;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="音箱管理" Tag="devices">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7F6;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="参数设置" Tag="settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <!-- Content Page Frame -->
            <Frame x:Name="ContentFrame"/>
        </NavigationView>

        <!-- Windows System Tray NotifyIcon -->
        <tb:TaskbarIcon x:Name="TrayIcon"
                        ToolTipText="MiAir 小爱音箱投播"
                        TrayLeftMouseDown="OnTrayIconLeftMouseDown">
            <tb:TaskbarIcon.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="显示主窗口" Click="OnShowMainWindowClick">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE737;"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator/>
                    <MenuFlyoutItem Text="退出 MiAir" Click="OnExitAppClick">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE711;"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>
    </Grid>
</Window>
