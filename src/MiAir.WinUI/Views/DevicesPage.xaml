<Page
    x:Class="MiAir.WinUI.Views.DevicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:MiAir.WinUI.Models"
    xmlns:vm="using:MiAir.WinUI.ViewModels"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,24,32,32">
        <StackPanel Spacing="24" MaxWidth="900" HorizontalAlignment="Stretch">
            
            <!-- Page Header -->
            <Grid>
                <StackPanel Spacing="4">
                    <TextBlock Text="音箱管理" Style="{StaticResource TitleTextBlockStyle}" FontWeight="SemiBold"/>
                    <TextBlock Text="绑定您的小米账号并指定投播的目标小爱音箱" Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <!-- Actions -->
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource AccentButtonStyle}" Click="OnOpenQrLoginClick">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8D7;" FontSize="13"/>
                            <TextBlock Text="扫码登录"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource DefaultButtonStyle}" Command="{x:Bind ViewModel.RefreshDevicesCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72C;" FontSize="13"/>
                            <TextBlock Text="刷新设备"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Status Banner -->
            <InfoBar IsOpen="{x:Bind ViewModel.StatusMessage, Mode=OneWay, Converter={StaticResource StringNotEmptyToBoolConverter}}"
                     Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                     Severity="Informational"
                     IsClosable="False"/>

            <!-- Loading indicator -->
            <ProgressBar IsIndeterminate="True"
                         Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                         HorizontalAlignment="Stretch"/>

            <!-- Speakers List Grid -->
            <ListView ItemsSource="{x:Bind ViewModel.Devices, Mode=OneWay}"
                      SelectionMode="None"
                      Padding="0">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0,0,0,12"/>
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:SpeakerDevice">
                        <Border CornerRadius="10"
                                BorderThickness="1"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                Padding="16">
                            <Grid ColumnSpacing="16" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Speaker Icon -->
                                <Border Grid.Column="0"
                                        Width="44" Height="44"
                                        CornerRadius="8"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                    <FontIcon Glyph="&#xE7F6;" FontSize="20" Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                                </Border>

                                <!-- Info Details -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind DisplayName}" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                        <Border CornerRadius="4"
                                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                Padding="6,2"
                                                Visibility="{x:Bind IsSelected}">
                                            <TextBlock Text="当前绑定" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <TextBlock Text="{x:Bind Hardware, Converter={StaticResource StringPrefixConverter}, ConverterParameter='型号: '}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="{x:Bind CurrentLocalIP, Converter={StaticResource StringPrefixConverter}, ConverterParameter='IP: '}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="{x:Bind DeviceID, Converter={StaticResource StringPrefixConverter}, ConverterParameter='DID: '}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Bind Button -->
                                <Button Grid.Column="2"
                                        Content="绑定此设备"
                                        Command="{Binding ElementName=RootPage, Path=ViewModel.SelectDeviceCommand}"
                                        CommandParameter="{x:Bind}"
                                        Style="{StaticResource DefaultButtonStyle}"
                                        VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

        </StackPanel>
    </ScrollViewer>
</Page>
