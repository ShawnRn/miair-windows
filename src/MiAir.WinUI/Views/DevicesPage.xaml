<Page
    x:Class="MiAir.WinUI.Views.DevicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:MiAir.WinUI.Models"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,24,32,32">
        <StackPanel Spacing="24" MaxWidth="900" HorizontalAlignment="Stretch">

            <!-- Page Header -->
            <Grid>
                <StackPanel Spacing="4">
                    <TextBlock Text="音箱设备管理" Style="{StaticResource TitleTextBlockStyle}" FontWeight="SemiBold"/>
                    <TextBlock Text="登录小米账号同步名下小爱音箱硬件并选择绑定投播目标" Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <!-- Actions Button Bar -->
                <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource AccentButtonStyle}" Click="OnOpenQrLoginClick">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE701;" FontSize="13"/>
                            <TextBlock Text="扫码登录小米账号"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding RefreshDevicesCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72C;" FontSize="13"/>
                            <TextBlock Text="刷新列表"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Status Notice InfoBar -->
            <InfoBar IsOpen="{Binding StatusMessage, Converter={StaticResource StringNotEmptyToBoolConverter}}"
                     Message="{Binding StatusMessage}"
                     Severity="Informational"
                     IsClosable="False"/>

            <!-- Loading indicator -->
            <ProgressBar IsIndeterminate="True"
                         Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                         HorizontalAlignment="Stretch"/>

            <!-- Speakers List Grid -->
            <ListView ItemsSource="{Binding Devices}"
                      SelectionMode="None"
                      Padding="0">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0,0,0,12"/>
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="10"
                                BorderThickness="1"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                Padding="16">
                            <Grid ColumnSpacing="16" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Speaker Icon -->
                                <Border Grid.Column="0"
                                        Width="44" Height="44"
                                        CornerRadius="8"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                    <FontIcon Glyph="&#xE7F6;" FontSize="20" Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                                </Border>

                                <!-- Info Details -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding DisplayName}" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                        <Border CornerRadius="4"
                                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                Padding="6,2"
                                                Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="当前绑定" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <TextBlock Text="{Binding Hardware, Converter={StaticResource StringPrefixConverter}, ConverterParameter='型号: '}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="{Binding CurrentLocalIP, Converter={StaticResource StringPrefixConverter}, ConverterParameter='IP: '}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="{Binding DeviceID, Converter={StaticResource StringPrefixConverter}, ConverterParameter='DID: '}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Action Select Button -->
                                <Button Grid.Column="2"
                                        Tag="{Binding}"
                                        Click="OnBindSpeakerClick"
                                        VerticalAlignment="Center"
                                        Padding="14,6">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE73E;" FontSize="12"/>
                                        <TextBlock Text="设为投播目标"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

        </StackPanel>
    </ScrollViewer>
</Page>
