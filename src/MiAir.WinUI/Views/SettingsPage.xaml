<Page
    x:Class="MiAir.WinUI.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:MiAir.WinUI.ViewModels"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,24,32,32">
        <StackPanel Spacing="24" MaxWidth="900" HorizontalAlignment="Stretch">
            
            <!-- Page Header -->
            <Grid>
                <StackPanel Spacing="4">
                    <TextBlock Text="参数设置" Style="{StaticResource TitleTextBlockStyle}" FontWeight="SemiBold"/>
                    <TextBlock Text="配置投播协议、音频低延迟缓冲、音源抢占策略与桌面行为" Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <!-- Save & Apply Button -->
                <Button Style="{StaticResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.SaveAndApplyCommand}"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Padding="20,8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74E;" FontSize="13"/>
                        <TextBlock Text="保存并应用"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Save Status Feedback -->
            <InfoBar IsOpen="{x:Bind ViewModel.SaveStatusText, Mode=OneWay, Converter={StaticResource StringNotEmptyToBoolConverter}}"
                     Message="{x:Bind ViewModel.SaveStatusText, Mode=OneWay}"
                     Severity="Success"
                     IsClosable="False"/>

            <!-- Section 1: Basic Config -->
            <StackPanel Spacing="12">
                <TextBlock Text="基本参数" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="SemiBold"/>
                
                <Border CornerRadius="10"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        Padding="20">
                    <StackPanel Spacing="16">
                        <!-- Device Name -->
                        <Grid>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="投放显示名称" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                <TextBlock Text="iPhone / Mac 与 Android DLNA 设备搜索时看到的名称" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <TextBox Width="260" HorizontalAlignment="Right" VerticalAlignment="Center"
                                     Text="{x:Bind ViewModel.DeviceName, Mode=TwoWay}"/>
                        </Grid>

                        <MenuFlyoutSeparator/>

                        <!-- AirPlay Switch -->
                        <Grid>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="启用 AirPlay 接收端" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                <TextBlock Text="允许 iOS、iPadOS 与 macOS 设备通过 AirPlay 串流音频" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <ToggleSwitch IsOn="{x:Bind ViewModel.AirPlayEnabled, Mode=TwoWay}"
                                          HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <MenuFlyoutSeparator/>

                        <!-- DLNA Switch -->
                        <Grid>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="启用 DLNA / UPnP 接收端" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                <TextBlock Text="允许网易云音乐、QQ音乐、AirMusic 等应用搜索并投送" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <ToggleSwitch IsOn="{x:Bind ViewModel.DlnaEnabled, Mode=TwoWay}"
                                          HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Section 2: Audio Buffer & Advanced -->
            <StackPanel Spacing="12">
                <TextBlock Text="音频与流转参数" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="SemiBold"/>

                <Border CornerRadius="10"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        Padding="20">
                    <StackPanel Spacing="16">
                        <!-- Audio Buffer MS -->
                        <Grid>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="音频预缓冲 (毫秒)" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                    <Border CornerRadius="4" Background="{ThemeResource SubtleFillColorSecondaryBrush}" Padding="6,2">
                                        <TextBlock Text="局域网推荐 300~500ms" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="控制连接后补发的数据量，数值越小起播越灵敏，0 为零延迟直通模式" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            
                            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Slider Width="200" Minimum="0" Maximum="1500" StepFrequency="50"
                                        Value="{x:Bind ViewModel.BufferMs, Mode=TwoWay}"
                                        VerticalAlignment="Center"/>
                                <TextBlock Text="{x:Bind ViewModel.BufferMs, Mode=OneWay, Converter={StaticResource StringPrefixConverter}, ConverterParameter=' ms'}"
                                           Width="60" TextAlignment="Right"
                                           VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            </StackPanel>
                        </Grid>

                        <MenuFlyoutSeparator/>

                        <!-- AirPlay Port -->
                        <Grid>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="AirPlay RTSP 端口" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                <TextBlock Text="默认端口 5000" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <NumberBox Width="140" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Value="{x:Bind ViewModel.AirPlayPort, Mode=TwoWay}" SpinButtonPlacementMode="Inline"/>
                        </Grid>

                        <MenuFlyoutSeparator/>

                        <!-- DLNA Port -->
                        <Grid>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="DLNA 控制与代理端口" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                <TextBlock Text="默认端口 8301" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <NumberBox Width="140" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Value="{x:Bind ViewModel.DlnaPort, Mode=TwoWay}" SpinButtonPlacementMode="Inline"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Section 3: Source Preemption Policy -->
            <StackPanel Spacing="12">
                <TextBlock Text="多设备音源抢占策略" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="SemiBold"/>

                <Border CornerRadius="10"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        Padding="20">
                    <StackPanel Spacing="16">
                        <!-- Policy Selection -->
                        <Grid>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="音源切换模式" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                <TextBlock Text="当多台手机或电脑同时投播时的优先处理规则" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>

                            <ComboBox Width="200" HorizontalAlignment="Right" VerticalAlignment="Center"
                                      SelectedIndex="{x:Bind ViewModel.SourcePolicyIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="最新设备优先 (推荐)"/>
                                <ComboBoxItem Content="当前设备锁定"/>
                                <ComboBoxItem Content="空闲后允许接管"/>
                                <ComboBoxItem Content="按协议优先级"/>
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Section 4: Windows Desktop Options -->
            <StackPanel Spacing="12">
                <TextBlock Text="桌面与系统行为" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="SemiBold"/>

                <Border CornerRadius="10"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        Padding="20">
                    <StackPanel Spacing="16">
                        <!-- Start on Boot -->
                        <Grid>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="开机时自动启动" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                <TextBlock Text="开机后静默启动并自动驻留在系统托盘后台" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <ToggleSwitch IsOn="{x:Bind ViewModel.StartOnBoot, Mode=TwoWay}"
                                          HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <MenuFlyoutSeparator/>

                        <!-- Minimize to Tray -->
                        <Grid>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="关闭窗口时最小化到系统托盘" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                <TextBlock Text="保持后台投播服务继续运行，双击托盘图标恢复窗口" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <ToggleSwitch IsOn="{x:Bind ViewModel.MinimizeToTrayOnClose, Mode=TwoWay}"
                                          HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
